# העתק ל-.env — או הרץ: python3 scripts/setup_env.py (ממלא הכול בשבילך)
# לעולם אל תעלי את .env ל-git.

# Telegram — מ-@BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=

# Supabase — Project Settings → API Keys / Data API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Claude API — console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Gmail OAuth (Desktop app) — הקבצים עצמם לא עולים ל-git
GMAIL_CREDENTIALS_PATH=config/credentials.json
GMAIL_TOKEN_PATH=config/token.json

# Public dashboard address (used in the bot's sign-up hint)
DASHBOARD_URL=
